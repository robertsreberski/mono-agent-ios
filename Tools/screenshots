#!/usr/bin/env python3
"""Run synthetic XCUI scenarios, export named PNGs and validate the artifact matrix."""
import argparse
import html
import json
import pathlib
import re
import shutil
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
ARTIFACTS = ROOT / "Artifacts"
MATRIX = json.loads((pathlib.Path(__file__).resolve().parent / "screenshot-matrix.json").read_text())["entries"]


def key(entry):
    return (entry["scenario"], entry["appearance"], entry.get("variant"))


def is_composer(scenario):
    return scenario.startswith("composer-") or scenario in {
        "conversation-ask-form", "conversation-quick-replies", "peer-question-sheet"}


EXPECTED = {key(entry): entry for entry in MATRIX}
if len(EXPECTED) != len(MATRIX):
    sys.exit("Duplicate entries in Tools/screenshot-matrix.json")

def run(*command, capture=False, timeout=None):
    return subprocess.run(command, cwd=ROOT, check=True, text=True,
                          stdout=subprocess.PIPE if capture else None, timeout=timeout).stdout

parser = argparse.ArgumentParser()
parser.add_argument("--iphone")
parser.add_argument("--ipad")
parser.add_argument("--family", choices=["iPhone", "iPad"], help="Run one CI matrix leg; default runs both")
parser.add_argument("--transcript-only", action="store_true", help="Focused transcript XCUI captures; preserves the full default matrix")
parser.add_argument("--composer-only", action="store_true", help="Focused composer XCUI captures; preserves the full default matrix")
parser.add_argument("--replies-only", action="store_true", help="Focused rich reply XCUI captures")
parser.add_argument("--accessibility-only", action="store_true", help="Additional accessibility and opaque review captures")
parser.add_argument("--scenario-only", action="store_true", help="Connection, dashboard, catalog and fidelity captures")
parser.add_argument("--activity-only", action="store_true", help="Job, subagent and context captures")
parser.add_argument("--mcp-only", action="store_true", help="Focused MCP UI scenarios and captures")
parser.add_argument("--batch-size", type=int, default=0, help="Bound XCUI runs by test count; each batch has a 19 minute timeout")
args = parser.parse_args()
if args.batch_size < 0:
    parser.error("--batch-size must be nonnegative")
if sum((args.transcript_only, args.composer_only, args.replies_only, args.mcp_only, args.scenario_only, args.activity_only, args.accessibility_only)) > 1:
    parser.error("Choose at most one focused capture")
def capture_suite(entry):
    scenario, variant = entry["scenario"], entry.get("variant")
    if ((scenario in {"composer-model-selector", "skill-browser", "conversation-ask-form", "conversation-quick-replies", "peer-question-sheet"}
         and variant in {"ax3", "opaque"})
        or (scenario == "connection-empty" and variant in {"editorax3", "editoropaque"})):
        return "accessibility"
    if scenario == "conversation-markdown" and variant == "context":
        return "activity"
    if scenario.startswith("conversation-mcp-"):
        return "mcp"
    if scenario in {"conversation-transcript", "conversation-streaming", "conversation-tools", "conversation-long", "conversation-markdown"}:
        return "transcript"
    if scenario in {"conversation-jobs", "conversation-job-stack", "conversation-subagents", "conversation-context", "peer-question"}:
        return "activity"
    if scenario in {"conversation-reply-files", "conversation-images", "conversation-restart-card", "conversation-attachments"}:
        return "replies"
    if is_composer(scenario) or scenario == "skill-browser":
        return "composer"
    return "scenario"

focused_suite = next((name for name in ("transcript", "composer", "replies", "mcp", "scenario", "activity", "accessibility")
                      if getattr(args, name + "_only")), None)
if focused_suite:
    EXPECTED = {key(entry): entry for entry in MATRIX if capture_suite(entry) == focused_suite}
if bool(args.iphone) != bool(args.ipad):
    parser.error("Supply both --iphone and --ipad, or neither for dynamic selection")
if args.iphone:
    listing = json.loads(run("xcrun", "simctl", "list", "--json", capture=True))
    devices = {}
    for family, identifier in (("iPhone", args.iphone), ("iPad", args.ipad)):
        for runtime, entries in listing["devices"].items():
            for device in entries:
                if device["udid"] == identifier and device.get("isAvailable") and device["name"].startswith(family):
                    devices[family] = {key: device[key] for key in ("name", "udid", "state")}
                    devices[family]["runtime"] = runtime
        if family not in devices:
            sys.exit(f"Unknown or unavailable {family} identifier")
else:
    devices = json.loads(run(str(ROOT / "Tools/select-simulators"), capture=True))
if args.family:
    devices = {args.family: devices[args.family]}
ARTIFACTS.mkdir(exist_ok=True)
(ARTIFACTS / "devices.json").write_text(json.dumps(devices, indent=2) + "\n")
output = ARTIFACTS / "Screenshots"
if output.exists() and any(output.iterdir()):
    sys.exit("Screenshots already exist; move or remove old Artifacts before rerunning")
output.mkdir(exist_ok=True)
for family in devices:
    if (ARTIFACTS / f"{family}.xcresult").exists():
        sys.exit(f"{family}.xcresult already exists; move or remove old Artifacts before rerunning")


class MatrixError(Exception):
    pass


def surface(scenario):
    if scenario.startswith("design-catalog"):
        return "design catalog"
    if scenario.startswith("project-"):
        return "project"
    if scenario.startswith("tag-"):
        return "tag"
    if scenario.startswith("wake-"):
        return "wake schedule"
    if scenario.startswith("dashboard-") or scenario in {"console-online", "fidelity-dashboard"}:
        return "dashboard"
    if scenario.startswith("organize-"):
        return "conversation"
    if scenario.startswith("conversation-") or is_composer(scenario) or scenario in {"fidelity-chat", "skill-browser", "peer-question"}:
        return "conversation"
    return "connection"


def test_batches():
    suites = {
        "transcript": ["TranscriptScenarioTests"], "composer": ["ComposerScenarioTests"],
        "replies": ["ReplyScenarioTests"], "mcp": ["McpScenarioTests"],
        "scenario": ["ScenarioTests"], "activity": ["ActivityScenarioTests"],
        "accessibility": ["AccessibilityReviewTests"],
    }
    selected = suites.get(focused_suite)
    unit = focused_suite in (None, "transcript")
    if not args.batch_size:
        return [[*(f"MonoAgentUITests/{name}" for name in selected),
                 *(["MonoAgentTests"] if unit else [])]] if selected else [[]]
    sources = sorted((ROOT / "AppUITests").glob("*.swift"))
    tests = []
    for source in sources:
        if selected is None or source.stem in selected:
            tests.extend(f"MonoAgentUITests/{source.stem}/{name}" for name in
                         re.findall(r"func (test\w+)\(", source.read_text()))
    if not tests:
        raise MatrixError("No XCUI tests discovered for batching")
    batches = [tests[i:i + args.batch_size] for i in range(0, len(tests), args.batch_size)]
    if unit:
        batches.append(["MonoAgentTests"])
    return batches


def capture(family, device):
    """Run bounded batches and validate their combined, exact screenshot matrix."""
    batches = test_batches()
    results = [ARTIFACTS / (f"{family}.xcresult" if i == 0 else f"{family}-batch-{i + 1}.xcresult")
               for i in range(len(batches))]
    if any(result.exists() for result in results):
        raise MatrixError(f"{family}: a batch result already exists")
    if device.get("state") != "Booted":
        run("xcrun", "simctl", "boot", device["udid"])
    run("xcrun", "simctl", "bootstatus", device["udid"], "-b")
    run("xcrun", "simctl", "status_bar", device["udid"], "override", "--time", "2001-01-01T09:41:00.000Z",
        "--batteryState", "charged", "--batteryLevel", "100", "--wifiMode", "active", "--wifiBars", "3")
    test_failures = []
    try:
        for number, (result, tests) in enumerate(zip(results, batches), 1):
            print(f"{family}: batch {number}/{len(batches)} ({len(tests)} selectors)", flush=True)
            try:
                run("xcodebuild", "-project", "MonoAgent.xcodeproj", "-scheme", "MonoAgent",
                    "-destination", f"platform=iOS Simulator,id={device['udid']}",
                    "-derivedDataPath", ".build/Xcode", "-resultBundlePath", str(result),
                    "-parallel-testing-enabled", "NO", "-collect-test-diagnostics", "never",
                    "CODE_SIGNING_ALLOWED=NO", "test",
                    *(f"-only-testing:{test}" for test in tests),
                    timeout=19 * 60 if args.batch_size else None)
            except (subprocess.CalledProcessError, subprocess.TimeoutExpired) as error:
                test_failures.append(f"{result.name}: {error}")
    finally:
        run("xcrun", "simctl", "status_bar", device["udid"], "clear")
    found = set()
    for number, result in enumerate(results, 1):
        if not result.exists():
            test_failures.append(f"{result.name}: no result bundle")
            continue
        exported = ARTIFACTS / (f"Attachments-{family}" if number == 1 else f"Attachments-{family}-batch-{number}")
        run("xcrun", "xcresulttool", "export", "attachments", "--path", str(result),
            "--output-path", str(exported))
        manifest = json.loads((exported / "manifest.json").read_text())
        for test in manifest:
            for attachment in test["attachments"]:
                match = re.match(r"synthetic-fixture__([a-z0-9-]+)__(light|dark)(?:__([a-z0-9]+))?(?:_\d+_[0-9A-Fa-f-]+)?(?:\.png)?$", attachment["suggestedHumanReadableName"])
                if not match:
                    continue
                scenario, appearance, variant = match.groups()
                entry = EXPECTED.get((scenario, appearance, variant))
                if entry is None:
                    raise MatrixError(f"Screenshot not in Tools/screenshot-matrix.json: {family} {match.group(0)}")
                if key(entry) in found:
                    raise MatrixError(f"Duplicate screenshot: {family} {key(entry)}")
                found.add(key(entry))
                source = exported / attachment["exportedFileName"]
                if source.suffix.lower() != ".png":
                    raise MatrixError("Expected PNG screenshot attachment")
                name = f"{family}__{scenario}__{appearance}" + (f"__{variant}" if variant else "") + ".png"
                target = output / name
                shutil.copyfile(source, target)
                run("sips", "-Z", "2000", str(target))
                dimensions = list(map(int, re.findall(r"pixel(?:Width|Height): (\d+)", run("sips", "-g", "pixelWidth", "-g", "pixelHeight", str(target), capture=True))))
                if len(dimensions) != 2 or not all(0 < dimension <= 2000 for dimension in dimensions):
                    raise MatrixError(f"Invalid screenshot dimensions: {name}")
                index.append(dict(file=name, device=device["name"], runtime=device["runtime"],
                                  scenario=scenario, appearance=appearance, variant=variant,
                                  textSize=entry["textSize"],
                                  transparency=entry["transparency"], theme=entry["theme"],
                                  surface=surface(scenario),
                                  label="synthetic fixture", dimensions=dimensions))
    if test_failures:
        raise MatrixError(f"{family}: test batches failed: {'; '.join(test_failures)}")
    if found != set(EXPECTED):
        raise MatrixError(f"Incomplete screenshot matrix for {family}; missing {sorted(set(EXPECTED) - found, key=str)}")


index = []
failures = []
# Every device runs even if an earlier one fails, so CI reports both results.
for family, device in devices.items():
    try:
        capture(family, device)
    except (MatrixError, subprocess.CalledProcessError) as error:
        print(f"FAILED {family}: {error}", file=sys.stderr)
        failures.append(f"{family}: {error}")
index_name = f"index-{args.family}" if args.family else "index"
(output / f"{index_name}.json").write_text(json.dumps(index, indent=2) + "\n")
(output / f"{index_name}.html").write_text("<!doctype html><meta charset='utf-8'><title>Synthetic fixture screenshots</title>" + "".join(
    f"<figure><img style='max-width:100%' src='{item['file']}'><figcaption>{html.escape(' / '.join([item['device'], item['runtime'], item['scenario'], item['appearance'], item['surface'], item['theme'] + ' theme', item['textSize'] + ' text size', item['transparency'] + ' transparency', item['label']]))}</figcaption></figure>" for item in index))
if failures:
    sys.exit(f"Screenshot matrix FAILED ({len(index)} screenshots exported):\n" + "\n".join(failures))
print(f"Exported {len(index)} synthetic fixture screenshots; every dimension <= 2000 px.")
