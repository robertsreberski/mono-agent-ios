#!/usr/bin/env python3
"""Fail if test fixture symbols or strings survive in a built Release application."""
import argparse
import pathlib
import subprocess
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser()
parser.add_argument("--app", type=pathlib.Path,
                    default=ROOT / ".build/Xcode/Build/Products/Release-iphonesimulator/MonoAgent.app")
args = parser.parse_args()
executable = args.app / "MonoAgent"
if not executable.is_file():
    sys.exit("Release app executable missing; build the unsigned Release simulator app first")
# Fixture transport, fixture hostname, DEBUG design catalog (types and scenario names),
# DEBUG dashboard fixture data and scenario names
# and design-package preview helpers must all be compiled out of Release. `nm -a` also
# lists debug-map source file names, so DEBUG-only files must not be named after markers.
MARKERS = (b"fixture-opaque", b"ScreenFixture", b"fidelity-chat", b"fidelity-dashboard", b"Map three beds", b"ScriptedTransport", b"console.example.ts.net", b"DesignCatalog", b"design-catalog",
           b"DesignPreviewMatrix", b"StoreScenario", b"ScenarioConsoleTransport", b"ScenarioEventSource",
           b"store-offline", b"store-streaming", b"store-unread", b"store-uncertain",
           b"DashboardFixture", b"dashboard-populated", b"dashboard-empty", b"dashboard-offline",
           b"dashboard-search", b"conversation-placeholder", b"fixture-theme",
           b"RichReplyFixture", b"conversation-reply-files", b"conversation-images", b"conversation-restart-card",
           b"JobFixture", b"conversation-jobs", b"conversation-job-stack", b"conversation-subagents", b"conversation-context",
           b"TranscriptFixture", b"conversation-streaming", b"conversation-tools", b"conversation-long", b"conversation-markdown",
           b"ComposerFixture", b"ComposerScript", b"composer-empty", b"composer-draft-attachments",
           b"composer-skill-picker", b"composer-model-selector", b"composer-running", b"composer-send-failed",
           b"composer-quote", b"conversation-ask-form", b"conversation-quick-replies", b"peer-question-sheet",
           b"Sample files (synthetic)")
images = [executable]
debug_library = args.app / "MonoAgent.debug.dylib"
if debug_library.is_file():
    images.append(debug_library)
for image in images:
    for tool in ("nm", "strings"):
        result = subprocess.run(["xcrun", tool, "-a", str(image)], check=True, capture_output=True)
        for marker in MARKERS:
            if marker in result.stdout:
                sys.exit(f"Release fixture leak: {marker.decode()} found by {tool} in {image.name}")
print("Release fixture check passed: nm/strings contain no fixture transport, fixture hostname, design catalog or preview helper.")
