#!/usr/bin/env python3
"""Generate transport descriptors, typed forwarding methods and reviewable coverage ledger."""
import json
import pathlib
import re
import subprocess

ROOT = pathlib.Path(__file__).resolve().parents[1]
RESOURCE = ROOT / "Packages/MonoAgentKit/Tests/MonoAgentKitTests/Resources/Contracts"
NAMES = """health mcpAppProxy bootstrap patchAgent putRunDefaults deleteRunDefaults refreshProviderUsage providerUsage restartAgent latestRestart restartOperation providerAuth startAuth authSession authInput cancelAuth startAuthCheck authCheck cancelAuthCheck skills cronOverview cronConfig cronRuns models cronRun createCronReply runCron enableCron createThread tags createTag patchTag deleteTag projects createProject patchProject deleteProject threads searchThreads activeThreads toolCall restartProposal message threadUsage thread messages attachmentAccess attachmentContent mcpAppAccess mcpAppResource mcpAppRequest job wakeSchedule createWake putWake patchWake deleteWake patchThread deleteThread compact startTurn startSubmission submissionReceipt liveInput cancelTurn ask askById answerAsk putPushSubscription pushSubscription deletePushSubscription testPushSubscription ackPush createUpload uploadContent deleteUpload stagedContent eventsRequest""".split()


def outputs():
    routes = json.loads((RESOURCE / "console-api.v1.routes.json").read_text())["routes"]
    assert len(routes) == len(NAMES), "Route count changed: review method names and native exclusions"
    ledger = []
    enum = ["// SPDX-License-Identifier: GPL-3.0-only", "// Generated by Tools/generate-routes. Do not edit.", "import Foundation", "", "public enum APIRoute: String, Sendable, CaseIterable {"]
    protocol = ["public protocol ConsoleAPI: ReplyContentReading {"]
    methods = ["extension APIClient {"]
    for route, name in zip(routes, NAMES):
        excluded = "/push/" in route["path"]
        entry = dict(route, operation=name, coverage="notApplicableToNative" if excluded else "covered")
        if excluded:
            entry["reason"] = "Browser Web Push subscriptions require a service worker; native notifications are outside this client."
        ledger.append(entry)
        enum.append(f"  case {name}")
        if excluded:
            continue
        params = re.findall(r":(\w+)", route["path"])
        args = [f"{p}: String" for p in params]
        callargs = [f'parameters: [{", ".join(chr(34)+p+chr(34)+": "+p for p in params)}]' if params else "parameters: [:]"]
        if "queryType" in route:
            args.append("query: " + route["queryType"])
            callargs.append("query: query")
        body = route["requestType"]
        response = route["responseType"]
        verb = route["method"]
        if body not in ("NoBody", "Binary"):
            args.append("body: " + body)
            callargs.append("body: body")
        if name == "uploadContent":
            args += ["file: URL", "progress: @escaping @Sendable (Double) -> Void"]
            result = "ApiUpload"
            expression = 'try await upload(id: id, file: file, progress: progress)'
        elif name == "eventsRequest":
            result = "URLRequest"
            expression = "try request(.eventsRequest, parameters: [:], query: query, body: nil)"
        elif response in ("Binary", "Html"):
            result = "Data"
            expression = f'try await binary(.{name}, {", ".join(callargs)})'
        elif response == "NoBody":
            result = "Void"
            expression = f'try await noContent(.{name}, {", ".join(callargs)})'
        elif verb == "GET":
            args.append("etag: String?")
            callargs.append("etag: etag")
            result = f"ReadResult<{response}>"
            expression = f'try await read(.{name}, {", ".join(callargs)})'
        else:
            result = response
            expression = f'try await send(.{name}, {", ".join(callargs)})'
        signature = f'func {name}({", ".join(args)}) async throws -> {result}'
        protocol.append("  " + signature)
        # Actor witnesses can provide convenience defaults, the protocol stays explicit.
        convenience = signature.replace("etag: String?", "etag: String? = nil")
        methods += ["  public " + convenience + " {", "    " + expression, "  }"]
    enum += ["", "  public var descriptor: RouteDescriptor {", "    switch self {"]
    for r, name in zip(routes, NAMES):
        statuses = lambda v: str(v).lower()
        enum += [f'    case .{name}: .init(method: "{r["method"]}", path: "{r["path"]}", requestType: "{r["requestType"]}", responseType: "{r["responseType"]}", successStatus: {statuses(r["successStatus"])}, resultStatuses: {statuses(r.get("resultStatuses", []))}, requiresClaimedOrigin: {str(r["requiresClaimedOrigin"]).lower()}, originPolicy: "{r["originPolicy"]}")']
    enum += ["    }", "  }", "}", ""]
    protocol += ["}", ""]
    methods += ["}", ""]
    return {"Contracts/routes-ledger.json": json.dumps({"version": 1, "routes": ledger}, indent=2) + "\n",
            "Packages/MonoAgentKit/Sources/MonoAgentKit/APIRoutes.swift": "\n".join(enum + protocol + methods)}


if __name__ == "__main__":
    for name, content in outputs().items():
        (ROOT / name).write_text(content)
        if name.endswith(".swift"):
            subprocess.run(["xcrun", "swift", "format", "format", "--in-place", str(ROOT / name)], check=True)
