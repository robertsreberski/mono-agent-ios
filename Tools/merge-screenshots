#!/usr/bin/env python3
"""Merge and validate the two independent simulator matrix screenshot indexes."""
import html
import json
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
output = pathlib.Path(sys.argv[1]) if len(sys.argv) > 1 else ROOT / "Artifacts/Screenshots"
matrix = json.loads((ROOT / "Tools/screenshot-matrix.json").read_text())["entries"]
expected = {(row["scenario"], row["appearance"], row.get("variant")) for row in matrix}
index = []
for family in ("iPhone", "iPad"):
    rows = json.loads((output / f"index-{family}.json").read_text())
    found = set()
    for row in rows:
        variant = "ax3" if "__ax3.png" in row["file"] else None
        key = (row["scenario"], row["appearance"], variant)
        assert key not in found, f"Duplicate {family} screenshot: {key}"
        found.add(key)
        assert row["file"].startswith(family + "__"), "Wrong family artifact"
        assert row["label"] == "synthetic fixture", "Missing fixture label"
        assert len(row["dimensions"]) == 2 and all(0 < x <= 2000 for x in row["dimensions"])
        assert (output / row["file"]).is_file(), f"Missing PNG: {row['file']}"
    assert found == expected, f"Incomplete {family} screenshot matrix"
    index.extend(rows)
(output / "index.json").write_text(json.dumps(index, indent=2) + "\n")
(output / "index.html").write_text(
    "<!doctype html><meta charset='utf-8'><title>Synthetic fixture screenshots</title>" + "".join(
        f"<figure><img style='max-width:100%' src='{html.escape(row['file'], quote=True)}'>"
        f"<figcaption>{html.escape(' / '.join([row['device'], row['runtime'], row['scenario'], row['appearance'], row['theme'], row['textSize'], row['transparency'], row['label']]))}</figcaption></figure>"
        for row in index))
print(f"Merged {len(index)} synthetic fixture screenshots from both matrix jobs.")
